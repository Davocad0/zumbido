  "notas": [
    {
      "autor": "D.",
      "noche": 7,
      "tipo": "advertencia",
      "soporte": "papel mojado, con la tinta corrida",
      "instrumento": "birome azul",
      "estado": [
        "mojada"
      ],
      "texto": "noche 7\naquí no pasa nada malo. eso es lo peor.\nme senté en el borde como dos horas mirando el agua. casi no me levanto.\nsi te pasa: LEVÁNTATE. los que se quedan sentados se quedan.",
      "pensamiento": "«Los que se quedan sentados se quedan»...",
      "x": 3,
      "y": 20
    },
    {
      "autor": "N.",
      "tipo": "diario",
      "soporte": "escrito con el dedo en el vaho del espejo del vestuario",
      "instrumento": "dedo",
      "estado": [
        "vaho"
      ],
      "texto": "el agua estaba fría ese día\ntú estabas con el celu\nyo quería que me vieras hacer el clavado",
      "pensamiento": "Yo estaba con el celular. Fueron dos minutos. Dos.",
      "x": 15,
      "y": 19
    },
    {
      "autor": "D.",
      "noche": 8,
      "tipo": "diario",
      "soporte": "hoja de cuaderno",
      "instrumento": "birome azul",
      "estado": [
        "arrugada",
        "mojada"
      ],
      "texto": "ya me acuerdo. ya me acuerdo.\nel hospital. la sala de espera con las sillas naranjas y el zumbido de las luces. me quedé dormido esperando que me dejaran verlo.\n~~fue mi culpa~~\n~~fue mi~~\nnoche 8",
      "pensamiento": "Me dormí en la sala de espera. Nico está en la cama 4.",
      "x": 17,
      "y": 14
    },
    {
      "autor": "D.",
      "tipo": "pista",
      "soporte": "reverso de una entrada de PlayLand",
      "instrumento": "lápiz",
      "estado": [
        "mojada",
        "doblada"
      ],
      "texto": "PLAYLAND AQUA · ENTRADA GENERAL Bs 60\nsigue el borde. las llaves están en los rincones donde nadie se metería.\nel agua no hace nada. creo.",
      "x": 11,
      "y": 9
    },
    {
      "autor": "M.",
      "tipo": "diario",
      "soporte": "hoja del libro de novedades, doblada en cuatro",
      "instrumento": "birome negra",
      "estado": [
        "mojada",
        "doblada",
        "vieja"
      ],
      "texto": "Ernesto lleva tres semanas en terapia intensiva. Yo pedí el turno de noche para limpiar su piso y estar cerca.\nLos médicos dicen que le hable, que a veces escuchan. Yo espero a que me llamen para pasar.\nMañana entro.\nM.",
      "pensamiento": "Marta también esperaba a alguien.",
      "x": 11,
      "y": 19
    },
    {
      "autor": null,
      "tipo": "objeto",
      "soporte": "gafas de natación",
      "instrumento": "ninguno",
      "estado": [
        "mojada"
      ],
      "texto": "Unas gafas de natación azules con el elástico cortado.",
      "pensamiento": "Son las gafas de Nico. Se las regalé yo.",
      "x": 14,
      "y": 3
    }
