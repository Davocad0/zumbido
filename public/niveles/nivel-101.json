      "autor": "D.",
      "noche": 9,
      "tipo": "diario",
      "soporte": "boleto de la rueda de la fortuna",
      "instrumento": "lápiz",
      "estado": [
        "arrugada",
        "sucia"
      ],
      "texto": "todas las noches la enfermera me dice que ya puedo pasar a verlo.\ntodas las noches le digo mañana.\nno sé qué decirle. perdón no alcanza.",
      "pensamiento": "Mañana. Siempre mañana.",
      "x": 3,
      "y": 10
    },
