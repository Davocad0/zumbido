  "notas": [
    {
      "autor": "D.",
      "noche": 4,
      "tipo": "regla",
      "soporte": "hoja de memorándum",
      "instrumento": "birome azul",
      "estado": [
        "arrugada",
        "mojada"
      ],
      "texto": "Si te acabas de despertar aquí: respira. Cuenta hasta 4 y suelta. A mí me sirvió (un poco).\nNo sé cómo llegué. Me imagino que tú tampoco.\nLo que sé:\n— el zumbido es bueno. Si se calla, ~~corre~~ NO corras. Escóndete y respira despacio.\n— la puerta roja no abre sin la llave roja. Lo sé porque la pateé como media hora.\n— en la sala de espera hay una tele con videocasetera. Graba la cinta. Después me agradeces.\nNoche 4.",
      "pensamiento": "¿Noche 4? ¿Quién cuenta las noches aquí?",
      "x": 1,
      "y": 2
    },
    {
      "autor": "D.",
      "tipo": "pista",
      "soporte": "post-it amarillo",
      "instrumento": "lápiz",
      "estado": [
        "doblada"
      ],
      "texto": "ya pasé por aquí\nya pasé por aquí\n¿ya pasé por aquí?\nsi el papel tapiz tiene manchas de humedad, sigue por ahí. la llave estaba al fondo, donde más huele a mojado.",
      "pensamiento": "Manchas de humedad... Bueno.",
      "x": 9,
      "y": 11
    },
    {
      "autor": "desconocido",
      "tipo": "advertencia",
      "soporte": "pedazo de cartón",
      "instrumento": "marcador negro",
      "estado": [
        "rota",
        "sucia"
      ],
      "texto": "SI SE APAGAN LAS LUCES NO TE MUEVAS",
      "respuesta": {
        "autor": "D.",
        "instrumento": "birome azul",
        "texto": "mentira. muévete, pero despacio y pegado a la pared."
      },
      "pensamiento": "Dos letras distintas. Alguien le contestó.",
      "x": 7,
      "y": 4
    },
