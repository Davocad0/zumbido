  "notas": [
    {
      "autor": "D.",
      "tipo": "diario",
      "soporte": "captura de pantalla impresa, doblada",
      "instrumento": "impreso",
      "estado": [
        "arrugada"
      ],
      "texto": "«¿CUÁNTO AGUANTA MI HERMANO BAJO EL AGUA? (EN VIVO)»\n2,3 M de vistas.\nNo lo borré. No puedo borrarlo y no puedo mirarlo.",
      "pensamiento": "Todavía está subido.",
      "x": 18,
      "y": 1
    },
    {
      "autor": "D.",
      "tipo": "diario",
      "soporte": "hoja de cuaderno, escrita con mucha fuerza",
      "instrumento": "birome negra",
      "estado": [
        "rota"
      ],
      "texto": "contaba en voz alta. cuarenta y ocho, cuarenta y nueve.\nel chat pedía diez más. «dale», «jajaja», «no sale nada».\nse los di.",
      "pensamiento": "Se los di.",
      "x": 15,
      "y": 21
    },
    {
      "autor": "N.",
      "tipo": "diario",
      "soporte": "servilleta mojada",
      "instrumento": "birome azul",
      "estado": [
        "mojada"
      ],
      "dibujo": "astro",
      "texto": "dani dijo que si llegaba a 60 me compraba el juego.\nllegué a 50 y después no me acuerdo.\nacá abajo sigo contando.",
      "pensamiento": "Sigo contando.",
      "x": 33,
      "y": 4
    },
    {
      "autor": "N.",
      "tipo": "diario",
      "soporte": "hoja plastificada de las reglas de la piscina",
      "instrumento": "crayón",
      "estado": [
        "mojada"
      ],
      "texto": "desde abajo se ven las caras.\ntodos tienen el celu.\nnadie se tira.",
      "pensamiento": "Nadie se tira.",
      "x": 23,
      "y": 33
    },
    {
      "autor": "N.",
      "tipo": "regla",
      "soporte": "tablita de las de aprender a nadar, escrita con crayón",
      "instrumento": "crayón",
      "estado": [
        "mojada"
      ],
      "texto": "más adelante alguien cuenta con la voz de dani.\nde espaldas, contra la pared. cuando llega a 50 se da vuelta con el celu.\nsi me alumbra, me graba. tengo que salir de la luz. si nado rápido cerca, cuenta más rápido.",
      "pensamiento": "Como ese día.",
      "x": 33,
      "y": 3
    }
