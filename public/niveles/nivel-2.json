  "notas": [
    {
      "autor": "D.",
      "tipo": "regla",
      "soporte": "escrito con tiza en una tubería",
      "instrumento": "tiza",
      "estado": [],
      "texto": "LINTERNA = TE VE\nOSCURIDAD = NO TE VE\n(pero tú tampoco)\nla apago cuando lo oigo respirar. respira como un perro viejo.\nlas pilas son viejas: si la apago un rato, vuelve un poco.",
      "x": 19,
      "y": 15
    },
    {
      "autor": "M.",
      "tipo": "regla",
      "soporte": "hoja del libro de novedades",
      "instrumento": "birome negra",
      "estado": [
        "mojada",
        "quemada"
      ],
      "texto": "Encontré un cuarto con una tele prendida. Mientras la tele está prendida, no entra.\nHay cintas. Si grabas, cuando te agarra despiertas ahí, como si no hubiera pasado nada.\nPero cada vez me acuerdo menos de mi casa.\nM.",
      "pensamiento": "«Despiertas ahí»...",
      "x": 7,
      "y": 17
    },
    {
      "autor": null,
      "tipo": "objeto",
      "soporte": "contrato de alquiler escrito a máquina",
      "instrumento": "máquina de escribir",
      "estado": [
        "vieja",
        "doblada"
      ],
      "texto": "CONTRATO DE ARRENDAMIENTO\nINQUILINO: Marta Rojas Quispe\nINMUEBLE: el que quede libre\nPLAZO: indefinido\nPAGO: lo que se pueda\nFIRMA:",
      "respuesta": {
        "autor": "M.",
        "instrumento": "birome negra",
        "texto": "M. Rojas",
        "temblorosa": true
      },
      "pensamiento": "Marta firmó. ¿Firmó para quedarse?",
      "x": 9,
      "y": 13
    },
    {
      "autor": "D.",
      "noche": 6,
      "tipo": "pista",
      "soporte": "hoja de cuaderno con estrellas dibujadas",
      "instrumento": "lápiz",
      "estado": [
        "arrugada"
      ],
      "texto": "noche 6\nhay un cuarto de niños entre las tuberías. MI cuarto. las estrellas que pegamos con nico en el techo, las mismas, en los mismos lugares. no puede ser.\ndebajo de la cama huele a polvo y a casa. ahí me escondí. una vez me encontró porque no podía dejar de jadear.\naguanta la respiración. cuenta.",
      "pensamiento": "Nico... mi hermano. ¿Qué hace mi hermano en estas notas?",
      "x": 7,
      "y": 20
    },
    {
      "autor": "N.",
      "tipo": "diario",
      "soporte": "papel quemado en las esquinas",
      "instrumento": "birome azul",
      "estado": [
        "quemada"
      ],
      "dibujo": "astro",
      "texto": "dani perdón por lo de la piscina. yo me metí a lo hondo solo, tú me dijiste que no.\nno le digas a mamá que fue mi culpa.",
      "pensamiento": "La piscina...",
      "x": 21,
      "y": 18
    },
    {
