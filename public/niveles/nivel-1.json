  "notas": [
    {
      "autor": "M.",
      "tipo": "diario",
      "soporte": "hoja del libro de novedades",
      "instrumento": "birome negra",
      "estado": [
        "vieja",
        "doblada"
      ],
      "texto": "LIBRO DE NOVEDADES — TURNO NOCHE\n02:14 Ronda pasillo B. Sin novedad.\n02:14 Ronda pasillo C. Las luces parpadean. Se avisa a mantenimiento.\n02:14 ¿El reloj está parado? Le cambié la pila.\nM. Rojas, limpieza",
      "pensamiento": "Todas a las 2:14.",
      "x": 1,
      "y": 3
    },
    {
      "autor": "M.",
      "tipo": "regla",
      "soporte": "otra hoja del mismo libro",
      "instrumento": "birome negra",
      "estado": [
        "mojada",
        "rota"
      ],
      "texto": "Ya no anoto la hora, para qué.\nHay alguien que camina cuando yo camino. Si me paro, se para.\nEn los casilleros no te encuentra, pero hay que entrar sin que te vea. Si te ve entrar, ya sabe dónde estás.\nNo es del personal. Le digo el Inquilino porque vive aquí y no paga.\nM.",
      "pensamiento": "El Inquilino...",
      "x": 11,
      "y": 5
    },
    {
      "autor": "D.",
      "noche": 5,
      "tipo": "regla",
      "soporte": "pedazo de cartón",
      "instrumento": "marcador azul",
      "estado": [
        "sucia"
      ],
      "texto": "noche 5\ncorrí. no sirve correr mucho: te quedas sin aire en nada y él no se cansa nunca.\ncorre solo cuando lo veas, y corre al escondite más cerca.\ncuando ya no puedes más, el cuerpo te da como un último empujón. se siente horrible, el corazón te revienta. ÚSALO PARA ESCONDERTE, no para seguir corriendo.",
      "pensamiento": "Ojalá no necesite ese empujón.",
      "x": 10,
      "y": 13
    },
    {
      "autor": "D.",
      "tipo": "advertencia",
      "soporte": "rayado en la puerta de un casillero",
      "instrumento": "punta de una llave",
      "estado": [
        "rayada"
      ],
      "texto": "NO USES EL MISMO CASILLERO 2 VECES\nSE ACUERDA",
      "x": 11,
      "y": 6
    },
    {
      "autor": "N.",
      "tipo": "diario",
      "soporte": "página de una revista de sala de espera",
      "instrumento": "birome azul",
      "estado": [
        "arrugada"
      ],
      "dibujo": "astro",
      "texto": "aquí hay una radio que dice el clima de una ciudad que no existe. 14 grados y llovizna en «puerto lindo». jaja\nextraño el celu. extraño las sopas de la abuela.\ndani, si estás leyendo esto: ya sé que vas a venir. siempre vienes.",
      "pensamiento": "«Siempre vienes»... ¿Quién es N.?",
      "x": 6,
      "y": 7
    },
    {
      "autor": "M.",
      "tipo": "regla",
      "soporte": "cinta de papel pegada en la tele",
      "instrumento": "birome negra",
      "estado": [
        "vieja"
      ],
      "texto": "NO APAGAR LA TELE.\nMientras se ven los videos, no entra. Llega hasta donde termina la luz y se queda ahí, mirando.\nCreo que se acuerda de algo.\nM.",
      "pensamiento": "¿Se acuerda de qué?",
      "x": 15,
      "y": 4
    }
